{
  "_about": "GSTR-1 canonical layer - which raw tab feeds which canonical table, and what each canonical field is called in the raw tab (spec: docs/GSTR1_CANONICAL_SPEC.md). Every GSTR-1 tab has the same shape: a title, ONE heading row, then a period-banner row per month with that month's data under it; the heading row is the non-empty row just above the first banner. Headings are compared after lower-casing and stripping every non-alphanumeric character. 'exact' = accepted spellings (first is the canonical one, the rest are aliases); 'contains' = a fragment of the heading; 'type': 'num' = converted to a number (blank cell = 0), 'raw' = kept exactly as in the source (text, dates, identifiers); 'required': true = ERROR if the column cannot be found (the table is then unusable). To support a renamed portal heading add its spelling to the right field's 'exact' list.",
  "version": "1",
  "tables": {
    "b2b": {
      "canon_sheet": "B2B_LINES", "raw_names": ["b2b, sez, de_inv"],
      "fields": {
        "gstin":    {"exact": ["GSTIN/UIN of Recipient", "GSTIN/UIN", "Recipient GSTIN"], "type": "raw"},
        "receiver": {"exact": ["Receiver Name"], "type": "raw"},
        "invno":    {"exact": ["Invoice Number", "Invoice/Advance Receipt Number"], "type": "raw"},
        "invdate":  {"exact": ["Invoice date"], "type": "raw"},
        "invval":   {"exact": ["Invoice Value"], "type": "num"},
        "pos":      {"exact": ["Place Of Supply"], "type": "raw"},
        "rcm":      {"exact": ["Reverse Charge"], "type": "raw"},
        "invtype":  {"exact": ["Invoice Type"], "type": "raw"},
        "rate":     {"exact": ["Rate", "Rate (%)"], "type": "num"},
        "taxable":  {"exact": ["Taxable Value"], "type": "num", "required": true},
        "igst":     {"exact": ["Integrated Tax"], "type": "num", "required": true},
        "cgst":     {"exact": ["Central Tax"], "type": "num", "required": true},
        "sgst":     {"exact": ["State/UT Tax"], "type": "num", "required": true},
        "cess":     {"exact": ["Cess Amount"], "type": "num", "required": true},
        "source":   {"exact": ["Source"], "type": "raw"},
        "irn":      {"exact": ["IRN"], "type": "raw"},
        "irndate":  {"exact": ["IRN date", "Ack Date", "Acknowledgement Date"], "type": "raw"}
      }
    },
